# Rebuildable HW5 simulation datasets and bootstrap checkpoints.
Homework Assignments/Homework 5/Output/q4_heteroskedastic_samples.rds
Homework Assignments/Homework 5/Output/q4_bootstrap_checkpoint.rds

# Replication data. Raw extracts are large and redistributable only from their
# original sources; processed files are rebuilt by the scripts in Replication/R.
Replication/Data/Raw/*
!Replication/Data/Raw/.gitkeep
Replication/Data/Processed/*
!Replication/Data/Processed/.gitkeep

# Secrets. API keys live in ~/.Renviron, outside the repository; these
# patterns are a backstop so a stray copy cannot be committed.
.Renviron
.env
*.secret
